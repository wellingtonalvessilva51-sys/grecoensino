# Copie para .env e preencha. NUNCA commitar o .env real.

# Banco (PostgreSQL — driver psycopg3)
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/gestao_educacional

# Auth
JWT_SECRET=troque-por-um-segredo-forte
JWT_ACCESS_EXPIRE_MINUTES=15
JWT_REFRESH_EXPIRE_DAYS=30

# IA (Anthropic)
ANTHROPIC_API_KEY=

# Aplicação
ENVIRONMENT=development
BASE_DOMAIN=localhost

# CORS: origens do front permitidas (separadas por vírgula). Default = Vite dev.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Deploy demo single-tenant (ver DEPLOY_RAILWAY.md). Em produção:
#   ALLOW_TENANT_HEADER=true  → aceita o header X-Tenant-ID (atalho de demo)
#   DEMO_TENANT_ID=<uuid fixo> → id da escola-a, injetado no front (window.__ENV__)
ALLOW_TENANT_HEADER=
DEMO_TENANT_ID=

# Seed demo (scripts.seed_dev) cria usuarios com senha conhecida. Roda sozinho
# so em development; em producao exige ALLOW_DEMO_SEED=true explicito.
ALLOW_DEMO_SEED=
# Opcional: sobrescreve as senhas demo sem mexer no codigo.
SEED_SENHA_ADMIN=
SEED_SENHA_RESP=
SEED_SENHA_SEC=
SEED_SENHA_PROF=

# Escola real (scripts.bootstrap_prod). Se BOOTSTRAP_ADMIN_EMAIL estiver
# definido, o entrypoint do container cria o admin uma unica vez.
BOOTSTRAP_ESCOLA=
BOOTSTRAP_SUBDOMINIO=
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_NOME=
# Se vazia, uma senha forte e gerada e impressa uma unica vez na saida.
BOOTSTRAP_ADMIN_SENHA=
