# Copie para .env e preencha. NUNCA commitar o .env real.

# Banco (PostgreSQL — driver psycopg3)
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/gestao_educacional

# Auth
JWT_SECRET=troque-por-um-segredo-forte
JWT_ACCESS_EXPIRE_MINUTES=15
JWT_REFRESH_EXPIRE_DAYS=30

# IA (Anthropic)
ANTHROPIC_API_KEY=

# Aplicação
ENVIRONMENT=development
BASE_DOMAIN=localhost

# CORS: origens do front permitidas (separadas por vírgula). Default = Vite dev.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
