# Copie para .env (não commitar o .env real).

# Base da API (FastAPI). Sem barra final.
VITE_API_BASE_URL=http://localhost:8000

# Tenant de desenvolvimento (multi-tenancy via header X-Tenant-ID em dev).
# Em produção o tenant vem do subdomínio; em dev, informe o UUID da escola.
# Pegue o id rodando o seed (scripts.seed_dev) ou consultando a tabela tenant.
# Ex. (seed local): escola-a -> 15f9163a-3bb5-41bf-80da-107fd1dbd0a7
VITE_TENANT_ID=
